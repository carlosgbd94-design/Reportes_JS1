        } else if (USER.rol === 'MUNICIPAL' || USER.rol === 'JURISDICCIONAL' || USER.rol === 'VISUALIZADOR_JURISDICCIONAL') {
          const mList = Array.isArray(USER?.municipiosAllowed) ? USER.municipiosAllowed : [];
          if (mList.includes('*')) {
