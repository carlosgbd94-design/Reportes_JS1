    $("new_municipio").value = hit.municipio || "";
  }
}

function applyAdminAutocompleteFromUnidad() {
  const unidad = $("new_unidad") ? $("new_unidad").value.trim() : "";
  const hit = findCatalogByUnidad(unidad);
  if (!hit) return;

  if ($("new_clues") && !$("new_clues").value.trim()) {
